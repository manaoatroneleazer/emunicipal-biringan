# ============================================================
# eMunicipal — Environment Configuration Template
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file to version control.
# ============================================================

# Application
APP_NAME=eMunicipal
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/eMunicipal

# Database — XAMPP defaults
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emunicipal
DB_USERNAME=root
DB_PASSWORD=

# Mail — Mailtrap Live SMTP (resident request/status notifications only)
# Host:     live.smtp.mailtrap.io
# Port:     587  (STARTTLS)
# Username: api  (fixed — always "api" for Mailtrap Live)
# Password: your Mailtrap API token (found in Mailtrap → Sending → API Tokens)
# From:     a sender address verified in your Mailtrap sending domain
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=eMunicipal

# Contact Form SMTP — website/municipal email transport (completely separate from Mailtrap above)
# These variables are used ONLY by the public Contact Form.
# The resident notification system never reads these values.
CONTACT_OWNER_EMAIL=
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_PASSWORD=
CONTACT_SMTP_FROM_ADDRESS=
CONTACT_SMTP_FROM_NAME=eMunicipal
# Encryption: tls (STARTTLS, port 587) or ssl (SMTPS, port 465)
CONTACT_SMTP_ENCRYPTION=tls

# Session
SESSION_LIFETIME=30

# HTTPS — set to true in production when the application is served over HTTPS.
# When true, session cookies are always flagged Secure regardless of server detection.
# Keep false for local XAMPP HTTP development.
APP_HTTPS=false

# File uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_PATH=storage/uploads
