# Environment — never commit real credentials
.env

# Composer dependencies
/vendor/

# Application logs
/storage/logs/*
!/storage/logs/.gitkeep

# Uploaded files — not version-controlled
/storage/uploads/**
!/storage/uploads/.gitkeep

# SQL dumps and database backups — never commit to version control
/storage/*.sql
*.sql.gz
*.sql.bz2

# Private backup directory (if created beside the project)
eMunicipal-private-backups/

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache
