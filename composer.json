{
    "name": "emunicipal/emunicipal",
    "description": "eMunicipal — Biringan City Online Document Request and Management System (Academic Demonstration Project)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "chillerlan/php-qrcode": "^5.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Emunicipal\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emunicipal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
