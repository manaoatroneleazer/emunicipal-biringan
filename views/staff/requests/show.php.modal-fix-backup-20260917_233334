// ---- Modals for actions requiring remark input ----
// Build once for each allowed next status that needs a modal
foreach ($allowedNext as $next):
    if (!isset($needsRemark[$next]) && $next !== RequestModel::STATUS_CANCELLED) continue;
    $isRemarkRequired = $needsRemark[$next]['required'] ?? false;
    $placeholder      = $needsRemark[$next]['placeholder'] ?? 'Optional remark';
    $btnLabel         = $actionLabels[$next] ?? ucwords(str_replace('_', ' ', $next));
    $btnCls           = str_replace('btn-outline-', 'btn-', $actionBtnCls[$next] ?? 'btn-secondary');
    $modal            = "modal-{$next}";
?>
<div class="modal fade" id="<?= $e($modal) ?>" tabindex="-1"
     aria-labelledby="<?= $e($modal) ?>-label" aria-modal="true"
     data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title h5" id="<?= $e($modal) ?>-label">
                    <?= $e($btnLabel) ?>
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST"
                  action="<?= $e($appUrl) ?>/staff/requests/<?= $requestId ?>/status"
                  data-loading="Updating…">
                <div class="modal-body">
                    <input type="hidden" name="_csrf_token" value="<?= $e($csrfToken) ?>">
                    <input type="hidden" name="new_status"  value="<?= $e($next) ?>">
                    <div class="mb-0">
                        <label for="remark-<?= $e($next) ?>" class="form-label">
                            <?= $isRemarkRequired ? 'Remark' : 'Reason' ?>
                            <?php if ($isRemarkRequired): ?>
                            <span class="text-danger" aria-hidden="true">*</span>
                            <?php else: ?>
                            <span class="text-muted">(optional)</span>
                            <?php endif; ?>
                        </label>
                        <textarea id="remark-<?= $e($next) ?>" name="remark" rows="3"
                                  class="form-control"
                                  placeholder="<?= $e($placeholder) ?>"
                                  <?= $isRemarkRequired ? 'required' : '' ?>></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn <?= $e($btnCls) ?>"><?= $e($btnLabel) ?></button>
                </div>
            </form>
        </div>
    </div>
</div>
